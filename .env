# OpenAI API Key
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Модель для vision-анализа фото
OPENAI_VISION_MODEL=gpt-4o

# Модель для AI Coach чата
OPENAI_CHAT_MODEL=gpt-4o

# USDA FoodData Central (бесплатно: https://fdc.nal.usda.gov/api-guide.html)
# Если пустой — используется локальная JSON-база
USDA_API_KEY=

# Порт
PORT=3000

# CORS (можно * для разработки, укажи конкретный origin на проде)
ALLOWED_ORIGINS=*
